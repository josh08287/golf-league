{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "eastus2"
    },
    "environmentName": {
      "value": "prod"
    },
    "appName": {
      "value": "golf-league"
    },
    "sqlConnectionString": {
      "value": "Server=tcp:capgolfleague-eca.database.windows.net,1433;Initial Catalog=capgolfleague;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=\"Active Directory Default\";"
    },
    "webOrigin": {
      "value": "https://app.golfleague.com"
    },
    "fido2RpId": {
      "value": "app.golfleague.com"
    },
    "allowedOrigins": {
      "value": [
        "https://app.golfleague.com",
        "https://admin.golfleague.com",
        "http://localhost:5173",
        "http://localhost:3000"
      ]
    }
  }
}
