# Entra External ID — create a separate app registration for the web SPA
VITE_ENTRA_CLIENT_ID=your-web-spa-client-id-here

# CIAM domain for External ID tenants (e.g., "yourtenant.ciamlogin.com")
# This enables local account sign-up alongside social providers like Google
# Leave blank to use standard login.microsoftonline.com
VITE_CIAM_DOMAIN=yourtenant.ciamlogin.com

# Redirect URI registered in the app registration
# Dev:  http://localhost:5173
# Prod: https://<your-static-web-app>.azurestaticapps.net
VITE_REDIRECT_URI=http://localhost:5173

# Azure Functions API base URL (optional — defaults to /api/v1 via Vite proxy in dev)
VITE_API_BASE_URL=https://golf-league-fn-g5vkqe.azurewebsites.net/api/v1
